{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "docsmith": {
                "type": "local",
                "command": [
                    "php",
                    "vendor/bin/docsmith",
                    "mcp:serve",
                    "--transport=stdio",
                    "--source=.",
                    "--docs-source=docs-source"
                ]
            }
        }
    }
}
